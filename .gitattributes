# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.ts text
*.js text
*.vue text
*.json text
*.md text
*.txt text
*.html text
*.css text
*.scss text
*.sass text
*.less text
*.xml text
*.yaml text
*.yml text
*.toml text
*.ini text
*.cfg text
*.conf text

# Declare files that will always have CRLF line endings on checkout
*.bat text eol=crlf
*.cmd text eol=crlf

# Declare files that will always have LF line endings on checkout
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.tar binary
*.rar binary
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.otf binary

# SVG files are text-based but often treated as images
*.svg text

# Web fonts
*.woff linguist-generated=true
*.woff2 linguist-generated=true

# Lock files should not be modified
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary

# Documentation
*.md linguist-documentation
docs/* linguist-documentation
*.txt linguist-documentation

# Generated files
dist/* linguist-generated=true
build/* linguist-generated=true
coverage/* linguist-generated=true
*.min.js linguist-generated=true
*.min.css linguist-generated=true

# Configuration files
*.config.js linguist-language=JavaScript
*.config.ts linguist-language=TypeScript
vite.config.* linguist-language=TypeScript
tsconfig.json linguist-language=JSON

# Vue.js specific
*.vue linguist-language=Vue

# Exclude certain files from language statistics
examples/* linguist-vendored
test/* linguist-vendored
tests/* linguist-vendored
spec/* linguist-vendored
__tests__/* linguist-vendored

# Mark generated TypeScript declaration files
*.d.ts linguist-generated=true

# Archives
*.tar filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text